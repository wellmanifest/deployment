{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/slot-manifest/v1",
  "title": "Immutable release-slot manifest v1",
  "description": "Offline wheelhouse or artifact bundle manifest for immutable slot installation. Grants no deployment or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "package", "version", "sourceSha", "artifacts"],
  "properties": {
    "schema": {"const": "wellmanifest.slot-manifest/v1"},
    "channel": {"enum": ["developer", "stable"]},
    "package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "sourceSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "allowPlatformWheels": {"type": "boolean"},
    "serial": {"type": "integer", "minimum": 1},
    "keyEpoch": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,199}$"},
          "sha256": {"$ref": "#/$defs/digest"},
          "sizeBytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payloadSha256", "value"],
      "properties": {
        "algorithm": {"enum": ["ed25519", "minisign-ed25519", "dsse-ed25519"]},
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
        "payloadSha256": {"$ref": "#/$defs/digest"},
        "value": {"type": "string", "minLength": 16, "maxLength": 4096}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"channel": {"const": "stable"}}, "required": ["channel"]},
      "then": {"properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "examples": [
    {
      "schema": "wellmanifest.slot-manifest/v1",
      "channel": "stable",
      "package": "heyasa-lab",
      "version": "0.1.6",
      "sourceSha": "5b2e49afee32ac5a02e56235b69718485967abfd",
      "allowPlatformWheels": true,
      "serial": 6,
      "keyEpoch": 1,
      "artifacts": [
        {
          "file": "heyasa_lab-0.1.6-py3-none-any.whl",
          "sha256": "0d7ab2259856bb7c3587aef8f4f9a6504a42b4545e5e30c4f69139d83bd9b96e",
          "sizeBytes": 65536
        }
      ]
    }
  ]
}
